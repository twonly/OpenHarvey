FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY contract_web ./contract_web
COPY static ./static
COPY runtime ./runtime
ENV CW_DATA_DIR=/data PYTHONDONTWRITEBYTECODE=1
EXPOSE 8080
CMD ["uvicorn", "contract_web.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080", "--timeout-graceful-shutdown", "10"]
