FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g opencode-ai@1.16.2
WORKDIR /work
ENV XDG_CONFIG_HOME=/state/config XDG_DATA_HOME=/state/data XDG_STATE_HOME=/state/state XDG_CACHE_HOME=/state/cache \
    OPENCODE_CONFIG=/run/opencode.json OPENCODE_DISABLE_CLAUDE_CODE=true OPENCODE_DISABLE_EXTERNAL_SKILLS=true \
    OPENCODE_ENABLE_QUESTION_TOOL=true OPENCODE_ENABLE_EXA=true OPENCODE_WEBSEARCH_PROVIDER=exa
EXPOSE 4096
CMD ["opencode", "serve", "--pure", "--hostname", "0.0.0.0", "--port", "4096"]
